# ============================================================
#  SWAP REFERENCES  — copy the block you need into
#  the ACTIVE CONFIGURATION section above.
# ============================================================
#
# ─── Development (Android emulator) ───
# ENV_NAME=development
# API_BASE_URL=http://10.0.2.2:5000/
#
# ─── Development (real device on LAN) ───
# ENV_NAME=development
# API_BASE_URL=http://192.168.1.11:5000/
#
# ─── Staging ───
# ENV_NAME=staging
# API_BASE_URL=https://sansa-backend-staging.vercel.app/
#
# ─── Production ───
ENV_NAME=production
API_BASE_URL=https://sansa-backend-prod.vercel.app/